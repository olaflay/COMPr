{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "../..",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true
  },
  "references": [
    { "path": "../../packages/contracts" }
  ],
  "include": [
    "src/**/*.ts",
    "../../lib/**/*.ts",
    "../../config/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../lib/image-precompress.ts",
    "../../lib/sdk.ts"
  ]
}
