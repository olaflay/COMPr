{
  "name": "@vecteus/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for Vecteus media ingestion and transcoding platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@vecteus/contracts": "1.0.0"
  }
}
