{
  "name": "@vecteus/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vecteus/web",
    "dev:api": "npm run dev --workspace=@vecteus/api",
    "dev:workers": "npm run dev --workspace=@vecteus/workers",
    "build": "npm run build --workspace=@vecteus/web",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@vecteus/web",
    "start:server": "node --experimental-strip-types --env-file=.env apps/api/src/index.ts",
    "start:workers": "node --experimental-strip-types --env-file=.env apps/workers/src/run-all.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --build",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "check:boundaries": "node --experimental-strip-types scripts/check-boundaries.ts",
    "verify:bundle-leakage": "node --experimental-strip-types scripts/verify-bundle-leakage.ts",
    "verify:packaging": "node --experimental-strip-types scripts/verify-packaging.ts",
    "verify:pipeline": "node --experimental-strip-types scripts/verify-b2b-pipeline.ts",
    "qualify:adversarial": "node --experimental-strip-types scripts/adversarial-qualification.ts",
    "audit:deep": "node --experimental-strip-types scripts/deep-systems-audit.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "generate:landing-images": "node --env-file=.env scripts/generate-landing-images.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/client": "^5.17.0",
    "@sentry/nextjs": "^10.70.0",
    "@sentry/node": "^10.66.0",
    "bullmq": "^5.12.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.11.1",
    "motion": "^14.4.0",
    "next": "^15.0.0",
    "posthog-js": "^1.404.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "postcss": "^8.5.19",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
