# Vecteus: Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database
# DATABASE_URL: pooled connection (used at runtime, e.g. a managed Postgres pgbouncer port)
# DIRECT_URL: unpooled connection (required by Prisma for migrations: see prisma/schema.prisma's directUrl)
DATABASE_URL="postgresql://compr:compr@localhost:5432/compr?schema=public"
DIRECT_URL="postgresql://compr:compr@localhost:5432/compr?schema=public"

# Redis (BullMQ queue backend)
REDIS_URL="redis://localhost:6379"

# docker-compose secrets (D-2 hardening): REQUIRED when running `docker compose up`
# Compose refuses to start infra with empty/default passwords, so set strong values:
POSTGRES_PASSWORD="<choose-a-strong-postgres-password>"
REDIS_PASSWORD="<choose-a-strong-redis-password>"

# Tigris (S3-compatible object storage): https://t3.storage.dev
# Endpoint: https://t3.storage.dev (canonical) or https://fly.storage.tigris.dev (legacy)
# Region is always "auto". Keys are tid_... / tsec_... (Tigris console > App Keys).
# Buckets must be created in the Tigris console BEFORE first upload: vecteus-uploads, vecteus-outputs
TIGRIS_ENDPOINT="https://t3.storage.dev"
TIGRIS_REGION="auto"
TIGRIS_ACCESS_KEY_ID="<your-tigris-access-key>"
TIGRIS_SECRET_ACCESS_KEY="<your-tigris-secret-key>"
TIGRIS_UPLOADS_BUCKET="vecteus-uploads"
TIGRIS_OUTPUTS_BUCKET="vecteus-outputs"

# Flutterwave (payment provider : Phase 2, install only for locked-stack completeness)
FLUTTERWAVE_PUBLIC_KEY="<your-flutterwave-public-key>"
FLUTTERWAVE_SECRET_KEY="<your-flutterwave-secret-key>"
FLUTTERWAVE_WEBHOOK_SECRET="<your-flutterwave-webhook-secret>"

# Sentry (error monitoring)
# SENTRY_DSN: used server-side (Fastify API, workers, Next.js server runtime)
# NEXT_PUBLIC_SENTRY_DSN: same DSN value, used client-side (instrumentation-client.ts) :
# must be duplicated under this name since only NEXT_PUBLIC_* vars reach the browser
SENTRY_DSN="<your-sentry-dsn>"
NEXT_PUBLIC_SENTRY_DSN="<your-sentry-dsn>"
SENTRY_AUTH_TOKEN="<your-sentry-auth-token>"
# Set SENTRY_SOURCE_MAPS=1 in deployment/CI to upload source maps during
# `next build`. Leave unset everywhere else: with it unset, the upload step is
# disabled so local builds never hang on Sentry (kept in .env.sentry-build-plugin).
# SENTRY_SOURCE_MAPS=1

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY="<your-posthog-public-key>"
NEXT_PUBLIC_POSTHOG_HOST="<your-posthog-host-or-https://app.posthog.com>"
POSTHOG_API_KEY="<your-posthog-personal-api-key>"

# Cryptography (fingerprint/IP hashing)
# Generate a strong salt: openssl rand -base64 32
CRYPTO_SALT="<your-random-base64-salt>"

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS="https://compr.app,http://localhost:3000"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Graceful shutdown (optional, defaults shown)
# DRAIN_TIMEOUT_MS: API server drain deadline before forced exit (default 30000)
# WORKER_DRAIN_TIMEOUT_MS: worker drain deadline before forced exit; set higher
# if encodes routinely take longer than 30s (default 30000)
# DRAIN_TIMEOUT_MS="30000"
# WORKER_DRAIN_TIMEOUT_MS="30000"
