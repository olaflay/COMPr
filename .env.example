# COMPr — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database
DATABASE_URL="postgresql://compr:compr@localhost:5432/compr?schema=public"

# Redis (BullMQ queue backend)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 (S3-compatible object storage)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<your-r2-access-key>"
R2_SECRET_ACCESS_KEY="<your-r2-secret-key>"
R2_UPLOADS_BUCKET="compr-uploads"
R2_OUTPUTS_BUCKET="compr-outputs"

# Flutterwave (payment provider — Phase 2, install only for locked-stack completeness)
FLUTTERWAVE_PUBLIC_KEY="<your-flutterwave-public-key>"
FLUTTERWAVE_SECRET_KEY="<your-flutterwave-secret-key>"
FLUTTERWAVE_WEBHOOK_SECRET="<your-flutterwave-webhook-secret>"

# Sentry (error monitoring)
SENTRY_DSN="<your-sentry-dsn>"
SENTRY_AUTH_TOKEN="<your-sentry-auth-token>"

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY="<your-posthog-public-key>"
NEXT_PUBLIC_POSTHOG_HOST="<your-posthog-host-or-https://app.posthog.com>"
POSTHOG_API_KEY="<your-posthog-personal-api-key>"

# Cryptography (fingerprint/IP hashing)
# Generate a strong salt: openssl rand -base64 32
CRYPTO_SALT="<your-random-base64-salt>"

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS="https://compr.app,http://localhost:3000"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000"
