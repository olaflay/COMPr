{
  "name": "noblur",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "start:server": "node --experimental-strip-types --env-file=.env server/index.ts",
    "start:workers": "node --experimental-strip-types --env-file=.env workers/run-all.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/client": "^5.17.0",
    "@sentry/nextjs": "^10.70.0",
    "@sentry/node": "^10.66.0",
    "bullmq": "^5.12.0",
    "fastify": "^5.10.0",
    "flutterwave-node-v3": "^1.4.1",
    "ioredis": "^5.11.1",
    "next": "^15.0.0",
    "posthog-js": "^1.404.1",
    "posthog-node": "^5.45.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.19",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
