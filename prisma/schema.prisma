// PRD §21 — Complete Prisma Data Model
// Phase 2 models (User, LedgerEntry, Payment) are forward-compat only,
// not wired to any Phase 1 code.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  QUEUED
  ANALYZING
  ENCODING
  VERIFYING
  DONE
  FAILED
}

enum PresetType {
  STATUS
  CHAT
  CUSTOM
}

enum MediaKind {
  VIDEO
  IMAGE
}

model Job {
  id                       String      @id @default(cuid())
  status                   JobStatus   @default(QUEUED)
  preset                   PresetType
  targetSizeMB             Int? // only set when preset = CUSTOM, validated 1-16 at API layer
  prioritizeDetail         Boolean     @default(false)
  mediaKind                MediaKind
  queuePosition            Int?        // denormalized from Redis queue (1-indexed), reduces O(n) polling
  destination              String      @default("WHATSAPP_NORMAL")
  sourceFile               MediaFile?  @relation("SourceFile", fields: [sourceFileId], references: [id])
  sourceFileId             String?     @unique
  outputs                  MediaFile[] @relation("OutputFiles")
  errorMessage             String?
  fingerprintHash          String
  ipHash                   String
  isPremium                Boolean     @default(false)
  isFirstJobForFingerprint Boolean     @default(false) // drives FR-11 reciprocity exemption

  // Adaptive engine fields
  analysisResult           Json?       // SceneAnalysis: face/text/motion scores per sampled frame
  profileId                String?     // Selected EncodingProfile for this job
  profile                  EncodingProfile? @relation(fields: [profileId], references: [id])
  vmafScore                Float?      // Final VMAF quality score after verification
  reencodeCount            Int         @default(0) // VMAF-triggered re-encode count

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  completedAt              DateTime?

  @@index([fingerprintHash, createdAt])
  @@index([status])
  @@index([profileId])
}

model MediaFile {
  id           String    @id @default(cuid())
  storageKey   String    @unique
  mimeType     String
  sizeBytes    Int
  durationSec  Float?
  width        Int?
  height       Int?
  segmentIndex Int? // only populated for Status videos over the duration ceiling
  role         String // "source" | "output"
  jobAsSource  Job?      @relation("SourceFile")
  jobAsOutput  Job?      @relation("OutputFiles", fields: [jobOutputId], references: [id])
  jobOutputId  String?
  expiresAt    DateTime
  deletedAt    DateTime? // written exclusively by the cleanup cron job
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

model UsageRecord {
  id              String   @id @default(cuid())
  fingerprintHash String
  ipHash          String
  date            DateTime @db.Date
  jobCount        Int      @default(0)
  bonusCount      Int      @default(0) // compressions granted via WhatsApp share, once per day

  @@unique([fingerprintHash, date])
  @@index([ipHash, date])
}

model PlatformLimit {
  id             String     @id @default(cuid())
  preset         PresetType
  maxDurationSec Int?
  maxResolutionW Int
  maxResolutionH Int
  maxSizeMB      Int
  effectiveFrom  DateTime   @default(now())
  notes          String?
}

model EncodingProfile {
  id              String   @id @default(cuid())
  name            String   @unique
  codec           String   // "libsvtav1" | "libx264" | "libaom-av1" | "librav1e"
  container       String   @default("mp4")
  crf             Int
  videoBitrateMax Int?     // Optional bitrate ceiling (kbps), null for pure CRF
  speedPreset     String   // SVT-AV1: "0-13", x264: "ultrafast-slow"
  pixelFormat     String   @default("yuv420p")
  audioCodec      String   @default("aac")
  audioBitrate    Int      @default(96) // kbps

  // Adaptive policy metadata — scene scores that select this profile
  minFaceScore    Float?   // Minimum face detection score to use this profile
  minTextScore    Float?   // Minimum text edge score to use this profile
  minMotionScore  Float?   // Minimum motion score to use this profile
  maxMotionScore  Float?   // Maximum motion score to use this profile

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobs            Job[]

  @@index([codec])
}

model OnboardingPreference {
  id              String   @id @default(cuid())
  fingerprintHash String   @unique
  primaryUse      String?
  priority        String?
  createdAt       DateTime @default(now())
}

// Phase 2+ (accounts/billing) — forward compatibility only, not active in MVP
// PRD §21 schema omitted reverse relation fields on User for LedgerEntry and
// Payment. Prisma requires both sides of a relation — these are added here so
// the schema compiles. These are Phase 2+ forward-compat models; no Phase 1
// code reads or writes them.
model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  isPremium             Boolean       @default(false)
  flutterwaveCustomerId String?
  balance               Int           @default(0)
  premiumExpiresAt      DateTime?
  createdAt             DateTime      @default(now())
  ledgerEntries         LedgerEntry[]
  payments              Payment[]
}

model LedgerEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Int
  oldBalance Int
  newBalance Int
  type       String // "CREDIT" | "DEBIT"
  reference  String? // Flutterwave tx_ref for idempotency
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id        String   @id @default(cuid())
  reference String   @unique // Flutterwave tx_ref — idempotency key
  status    String // "successful" | "failed" | "pending"
  amount    Int
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
