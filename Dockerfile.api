# Dockerfile for Fastify API backend server
FROM node:22-slim

# Prisma's query engine dynamically links against libssl at runtime — without
# this, node:22-slim (Debian 12/bookworm) has no libssl.so present at all,
# regardless of which binaryTarget Prisma was generated for.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency configuration
COPY package.json package-lock.json ./

# Install all dependencies (development dependencies needed for building/prisma generate)
RUN npm ci

# Copy Prisma schema and generate Client
COPY prisma/ ./prisma/
RUN npx prisma generate

# Copy application source files
COPY server/ ./server/
COPY lib/ ./lib/
COPY config/ ./config/
COPY tsconfig.json ./tsconfig.json

# Clean up dev dependencies to keep production image smaller
# Note: we need to keep prisma client and node modules intact.
# npm prune --production removes devDependencies but keeps dependencies like @prisma/client
RUN npm prune --production

EXPOSE 5000

ENV PORT=5000

CMD ["node", "--experimental-strip-types", "server/index.ts"]
